# =============================================================================
# IMA AGENT - VARIABLES DE ENTORNO (PLANTILLA DE CONFIGURACIÓN)
# Copia este archivo como '.env' y completa los valores correspondientes.
# NUNCA subas el archivo '.env' real a repositorios públicos o compartidos.
# =============================================================================

# --- INTELIGENCIA ARTIFICIAL (ANTHROPIC CLAUDE) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- MICROSOFT 365 & AZURE AD (GRAPH API) ---
MSGRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MSGRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MSGRAPH_CLIENT_SECRET=tu_client_secret_aqui
MS365_MONITOR_EMAIL=sebastien.martinet@ima-si.com.ar

# --- SHAREPOINT ONLINE ---
# IDs de SharePoint para almacenamiento de pliegos y ofertas
SHAREPOINT_TENDERS_SITE_ID=
SHAREPOINT_TENDERS_DRIVE_ID=

# IDs de SharePoint para planilla comercial de oportunidades (BD_Oportunidades.xlsx)
